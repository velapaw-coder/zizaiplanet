{
  "name": "zizai-planet",
  "version": "0.1.2",
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@vinext/cloudflare": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "vinext": "^1.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "tailwindcss": "latest",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 4317 --strictPort",
    "predev": "wrangler d1 migrations apply DB --local && wrangler d1 execute DB --local --file=./seed/seed.sql",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json --port 4317 --ip 0.0.0.0",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file=./seed/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=./seed/seed.sql",
    "test": "tsx --test lib/compose.test.ts lib/identity.test.ts lib/moderate.test.ts lib/password.test.ts lib/explore-plan.test.ts lib/profile-generate.test.ts lib/aspiration.test.ts"
  }
}
